{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FacturaMicro",
  "version": "1.0.0",
  "identifier": "app.facturamicro.desktop",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "FacturaMicro",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "FacturaMicro",
    "copyright": "© FacturaMicro",
    "category": "Business",
    "shortDescription": "Facturation pour micro-entreprises",
    "longDescription": "Application de facturation 100% locale pour micro-entrepreneurs : multi-pays, multi-langues, multi-devises, exports JSON.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
